    <dependencies>
        <dependency>
            <groupId>io.edap</groupId>
            <artifactId>edap-tx-api</artifactId>
            <version>${edap.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
