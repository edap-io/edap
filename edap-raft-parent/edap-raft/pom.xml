<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.edap</groupId>
        <artifactId>edap-raft-parent</artifactId>
        <version>${edap.version}</version>
    </parent>

    <artifactId>edap-raft</artifactId>

    <description>
        edap 的 Raft 共识实现：Leader 选举、日志复制、多数派提交、状态机 apply、
        日志压缩与 InstallSnapshot、joint consensus 成员变更、ReadIndex 线性一致读。
        传输层基于 edap-nio-server 的 Server/NioServerSession/Decoder 体系，
        持久化通过 RaftStorage SPI 提供内存与文件两套实现。
    </description>

    <dependencies>
        <dependency>
            <groupId>io.edap</groupId>
            <artifactId>edap-nio-server</artifactId>
            <version>${edap.version}</version>
        </dependency>
        <!--
            平台时间门面与平台级时间轮（io.edap.util / io.edap.util.timing）。
            直接依赖而不是靠 edap-nio-server 传递 —— Node.startTicker() 直接用
            io.edap.util.timing.TimerService，模块本身不自带定时器线程。
        -->
        <dependency>
            <groupId>io.edap</groupId>
            <artifactId>edap-common</artifactId>
            <version>${edap.version}</version>
        </dependency>
        <dependency>
            <groupId>io.edap</groupId>
            <artifactId>edap-log-api</artifactId>
            <version>${edap.version}</version>
        </dependency>

        <!-- 单元测试相关依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 队列基准测试(JMH) -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 父 pom 的 surefire 配置是 <skipTests>${skipTests}</skipTests>(属性默认 true),
                 这里必须同样引用属性 —— 写死 false 是 POM 插件显式配置,既覆盖父 pom,
                 又压不动命令行的 -DskipTests=...,导致 `mvn install` 照样跑测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                    <!-- edap-nio 的 FastSelectorProvider 反射 sun.nio.ch,
                         edap-common 的 UnsafeUtil 反射 java.nio.Buffer.address,
                         JDK17 下不加这些开关会抛 InaccessibleObjectException -->
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
