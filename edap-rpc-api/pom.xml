<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>edap</artifactId>
        <groupId>io.edap</groupId>
        <version>${edap.version}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <!--
      gRPC / eRPC 共用的 RPC 上下文底座：每次调用的身份、deadline、取消信号、
      键值属性，以及跨进程的超时编解码。

      ★ 本模块刻意「零运行时依赖」—— 只有 JDK —— 这样任何协议模块引入它都
        不会带来传递依赖。同 edap-protobuf-wire 放 io.edap.rpc.StreamObserver
        的理由一样。
    -->
    <artifactId>edap-rpc-api</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
